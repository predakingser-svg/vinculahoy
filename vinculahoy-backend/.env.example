# ==============================================================================
# CONFIGURACIÓN DE VINCULAHOY (REDFUTURO) - AMBIENTE MVP
# ==============================================================================

PROJECT_NAME="VinculaHoy"
DEBUG=True
API_V1_STR="/api/v1"

# ------------------------------------------------------------------------------
# BASE DE DATOS POSTGRESQL + POSTGIS (SUPABASE FREE TIER)
# ------------------------------------------------------------------------------
# 1. En tu proyecto de Supabase ve a: Project Settings -> Database -> Connection string
# 2. Selecciona "URI" en modo "Transaction" o "Session".
# 3. Recuerda habilitar la extensión PostGIS ejecutando en el SQL Editor de Supabase:
#    CREATE EXTENSION IF NOT EXISTS postgis;
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql+asyncpg://postgres:TU_PASSWORD_AQUI@db.TU_PROJECT_REF.supabase.co:5432/postgres"

# (Opcional) URL para SQLite asíncrono para pruebas locales sin conexión a internet:
# DATABASE_URL="sqlite+aiosqlite:///./vinculahoy.db"

# ------------------------------------------------------------------------------
# SEGURIDAD Y JWT (JSON WEB TOKENS)
# ------------------------------------------------------------------------------
# Genera una clave segura con: openssl rand -hex 32
SECRET_KEY="vinculahoy_super_secret_jwt_key_change_me_in_production_2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 horas

# ------------------------------------------------------------------------------
# CONFIGURACIÓN CORS (CLOUDFLARE PAGES / LOCALHOST)
# ------------------------------------------------------------------------------
# Orígenes permitidos separados por coma o en formato JSON
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:8000","https://vinculahoy.pages.dev"]

# ------------------------------------------------------------------------------
# MARCO LEGAL Y DESCARGO DE RESPONSABILIDAD OBLIGATORIO
# ------------------------------------------------------------------------------
LEGAL_DISCLAIMER="Plataforma independiente de vinculación comunitaria sin afiliación, patrocinio ni relación oficial con el Gobierno de México o el programa Jóvenes Construyendo el Futuro."
